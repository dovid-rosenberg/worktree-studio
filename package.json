{
  "name": "worktree-studio",
  "version": "0.1.0",
  "private": true,
  "description": "One place to start, watch, and steer Claude Code sessions — pluggable intake, baked-in worktrees, embedded multiplexer terminals, hook-driven status, and resume-after-shutdown.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wt-studio": "bin/wt-studio.ts"
  },
  "scripts": {
    "start": "node server/server.ts",
    "build": "node bin/build-client.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test test/*.test.js",
    "vendor": "node bin/vendor.ts",
    "fix-pty": "node bin/fix-pty.ts",
    "postinstall": "node bin/fix-pty.ts && node bin/vendor.ts && node bin/build-client.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "express": "^5.2.1",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
