{
  "name": "worktree-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestrate Claude Code sessions across git worktrees: one screen for every agent, worktree and dev server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wt-studio": "bin/wt-studio.ts"
  },
  "scripts": {
    "start": "node server/server.ts",
    "build": "node bin/build-client.ts",
    "typecheck": "tsc --noEmit && npm --prefix client run check",
    "test": "npm run typecheck && node --test 'test/**/*.test.ts' && npm --prefix client test",
    "test:server": "node --test 'test/**/*.test.ts'",
    "fix-pty": "node bin/fix-pty.ts",
    "postinstall": "node bin/fix-pty.ts && node bin/build-client.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "npm run lint && npm run typecheck",
    "format:check": "biome format",
    "verify": "npm run lint && npm run format:check && npm test",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "express": "^5.2.1",
    "node-pty": "^1.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dovid-rosenberg/worktree-studio.git"
  },
  "keywords": [
    "claude-code",
    "git-worktree",
    "tmux",
    "developer-tools"
  ]
}
