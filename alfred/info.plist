	</dict>
	<key>objects</key>
	<array>
		<dict>
			<key>config</key>
			<dict>
				<!-- Alfred does the filtering: the script answers with everything and
				     Alfred fuzzy-matches the `match` field. Re-running a curl on every
				     keystroke would be slower and match worse. -->
