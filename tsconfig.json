{
  // Type-checking only. Node 22 runs .ts directly by stripping the types, so nothing
  // here ever emits and `npm start` stays a bare `node server/server.ts` — no build
  // step, no dist/. `erasableSyntaxOnly` is what keeps that true: it rejects exactly
  // the syntax Node cannot strip (enum, namespace, parameter properties, decorators),
  // so a file that type-checks is a file that runs.
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],

    "strict": true,
    "noEmit": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // No allowJs: a module still awaiting conversion is invisible to tsc rather than
  // half-checked. Conversion runs leaves-first, so an imported module is already .ts
  // by the time its consumer is converted and the gate stays green at every commit.
  "include": ["server/**/*.ts", "test/**/*.ts", "bin/**/*.ts"],
  "exclude": ["node_modules", "client", "public"]
}
