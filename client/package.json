{
  "name": "worktree-studio-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SvelteKit frontend for Worktree Studio. Built to static files and served by the Express daemon; the daemon is the only server.",
  "scripts": {
