{
  "name": "worktree-studio-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SvelteKit frontend for Worktree Studio. Built to static files and served by the Express daemon; the daemon is the only server.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0"
  }
}
